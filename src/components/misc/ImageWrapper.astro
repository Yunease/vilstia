---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	// Explicit display size, mainly for external images where the browser
	// can't infer aspect ratio. Also forwarded to the local <Image> as a hint.
	width?: number;
	height?: number;
	// Responsive candidate widths for Astro <Image> to generate srcset.
	// Only used for local images; ignored for external/public images.
	widths?: number[];
	// Sizes attribute for the <img> tag, describing the intended display width.
	sizes?: string;
	// Defaults to "lazy". Pass "eager" for above-the-fold / LCP images.
	loading?: "eager" | "lazy";
	// Hint for the browser's fetch priority. Use "high" for the LCP image
	// (typically the hero/banner) so the browser starts loading it earlier.
	fetchpriority?: "high" | "low" | "auto";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	width,
	height,
	widths,
	sizes,
	loading = "lazy",
	fetchpriority,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image
		src={img}
		alt={alt || ""}
		class={imageClass}
		style={imageStyle}
		width={width}
		height={height}
		widths={widths}
		sizes={sizes}
		loading={loading}
		decoding="async"
		fetchpriority={fetchpriority}
	/>}
    {!isLocal && <img
		src={isPublic ? url(src) : src}
		alt={alt || ""}
		class={imageClass}
		style={imageStyle}
		width={width}
		height={height}
		sizes={sizes}
		loading={loading}
		decoding="async"
		fetchpriority={fetchpriority}
	/>}
</div>
