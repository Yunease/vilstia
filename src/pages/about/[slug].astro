---

import { render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { siteConfig } from "../../config";
import { getCachedSpec } from "../../utils/datasource";
import { absUrl, resolvePersonId } from "../../utils/seo-utils";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const allSpec = await getCachedSpec();
	const aboutPosts = allSpec.filter(({ id }) => id.startsWith("about"));
	return aboutPosts.map((post) => {
		// 去掉 "about" 前缀和 ".md" 后缀
		const slug =
			post.id.replace("about", "").replace(/^\//, "").replace(/\.md$/, "") ||
			"default";
		return {
			params: { slug },
			props: { post },
		};
	});
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug =
	post.id.replace("about", "").replace(/^\//, "").replace(/\.md$/, "") ||
	"default";
const pageUrl = absUrl(Astro.site, url(`/about/${slug}/`));
const personId = await resolvePersonId(Astro.site);
const siteUrl = absUrl(Astro.site, "/");

const aboutPageJsonLd: any = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	"@id": `${pageUrl}#webpage`,
	url: pageUrl,
	name: post.data.title,
	description: post.data.description || i18n(I18nKey.about),
	inLanguage: siteConfig.lang.replace("_", "-"),
	isPartOf: { "@id": `${siteUrl}#website` },
};
if (post.data.tag === "me") {
	aboutPageJsonLd.about = { "@id": personId };
} else {
	aboutPageJsonLd.about = {
		"@type": "Thing",
		name: post.data.title,
	};
}
---

<MainGridLayout title={post.data.title} description={post.data.description || i18n(I18nKey.about)}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(aboutPageJsonLd)}></script>
    <div class="about-wrapper">
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
            <div class="card-base z-10 px-9 py-6 relative w-full ">
                <Markdown class="mt-2">
                    <Content />
                </Markdown>
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
    .about-wrapper {
        animation: fade-in-up 300ms ease-out;
        animation-fill-mode: forwards;
    }

    @keyframes fade-in-up {
        0% {
            transform: translateY(1rem);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>
