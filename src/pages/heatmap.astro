---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostHeatmap from "../components/PostHeatmap.astro";
import { getPostActivityData } from "../utils/content-utils";
import { getCachedPosts } from "../utils/datasource";

const allPosts = await getCachedPosts();
const heatmapData = getPostActivityData(
	import.meta.env.PROD
		? allPosts.filter(({ data }) => data.draft !== true)
		: allPosts,
);
---

<MainGridLayout title="创作热力图" description="博客创作历史全览">
	<div class="transition flex flex-col gap-4">
		<PostHeatmap data={heatmapData} />
	</div>
</MainGridLayout>
