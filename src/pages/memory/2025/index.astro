			justify-content: space-between;
			align-items: center;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			font-weight: 700;
			margin-bottom: 20px;
		}
		.pink-code {
			color: var(--accent-pink-main);
		}
		.pink-stat {
			color: var(--accent-pink-main);
		}
		.cell-title {
			font-size: 1.5rem;
			font-weight: 800;
			margin: 0 0 16px;
			line-height: 1.3;
		}
		.pink-title {
			color: #9d174d;
		}
		.cell-text {
			font-size: 0.95rem;
			line-height: 1.75;
			color: var(--text-dim);
			margin: 0 0 24px;
		}
		.cell-keywords {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
			margin-bottom: 30px;
		}
		.kw-tag {
			font-family: var(--font-mono);
			font-size: 0.75rem;
			padding: 4px 10px;
			border: 1px solid var(--grid-line);
			background: #ffffff;
			font-weight: 600;
		}
		.pink-kw {
			border-color: var(--accent-pink-main);
			background: #ffffff;
			color: #be185d;
		}
		.cell-quote {
			margin-top: auto;
			padding: 16px;
			border-left: 3px solid var(--text-black);
			background: rgba(0, 0, 0, 0.04);
			font-family: var(--font-serif);
			font-size: 0.88rem;
			line-height: 1.6;
			font-style: italic;
		}
		.pink-quote {
			border-left-color: var(--accent-pink-main);
			background: rgba(236, 72, 153, 0.08);
			color: #831843;
		}

		/* CHAPTER 2: MOOD MATRIX */
		.mood-matrix {
			border-bottom: 1px solid var(--grid-line);
		}
		.mood-cells-grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
		}
		.mood-grid-cell {
			background: var(--grid-surface);
			border: none;
			border-right: 1px solid var(--grid-line);
			padding: 24px 20px;
			text-align: left;
			cursor: pointer;
			display: flex;
			flex-direction: column;
			gap: 12px;
			transition: all 0.2s;
			outline: none;
		}
		.mood-grid-cell:last-child {
			border-right: none;
		}
		.mood-grid-cell:hover, .mood-grid-cell.active {
			background: var(--m-bg);
			box-shadow: inset 0 -4px 0 var(--m-color);
		}
		.mood-cell-top {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}
		.mood-sign {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			color: var(--m-color);
			font-weight: 700;
		}
		.mood-name {
			font-weight: 800;
			font-size: 1.25rem;
		}
		.mood-count {
			font-family: var(--font-mono);
			font-size: 1.8rem;
			font-weight: 900;
			line-height: 1;
			color: var(--m-color);
		}
		.mood-bar-track {
			height: 4px;
			background: rgba(0, 0, 0, 0.08);
			overflow: hidden;
		}
		.mood-bar-fill {
			height: 100%;
			background-color: var(--m-color);
		}
		.mood-cell-bot {
			display: flex;
			justify-content: space-between;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			color: var(--text-dim);
		}
		.mood-hint {
			opacity: 0;
			transition: opacity 0.2s;
		}
		.mood-grid-cell:hover .mood-hint {
			opacity: 1;
		}

		/* CHAPTER 2: MOOD FOCUS BANNER */
		.mood-focus-banner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 12px 24px;
			background: var(--accent-pink-soft);
			border-top: 1px solid var(--accent-pink-main);
			font-family: var(--font-mono);
			font-size: 0.8rem;
			color: #831843;
			font-weight: 600;
		}
		.mf-left {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-wrap: wrap;
		}
		.mf-dot {
			color: var(--accent-pink-main);
		}
		.btn-clear-filter {
			background: #ffffff;
			border: 1px solid var(--accent-pink-main);
			color: #be185d;
			font-family: var(--font-mono);
			font-size: 0.75rem;
			font-weight: 700;
			padding: 4px 10px;
			cursor: pointer;
			transition: all 0.15s;
		}
		.btn-clear-filter:hover {
			background: var(--accent-pink-main);
			color: #ffffff;
		}

		/* Dynamic Mood Voice Card */
		.mood-quote-display {
			padding: 18px 24px;
			background: #ffffff;
			border-top: 1px solid var(--grid-line);
			display: flex;
			flex-direction: column;
			gap: 8px;
			transition: all 0.25s ease;
		}
		.mq-meta {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-family: var(--font-mono);
			font-size: 0.75rem;
		}
		.mq-tag {
			font-weight: 700;
			color: var(--accent-pink-main);
			background: var(--accent-pink-soft);
			padding: 2px 8px;
			border: 1px solid var(--accent-pink-main);
		}
		.mq-date {
			color: var(--text-muted);
		}
		.mq-text {
			font-family: var(--font-serif);
			font-size: 0.95rem;
			line-height: 1.7;
			color: var(--text-black);
			margin: 0;
			padding-left: 12px;
			border-left: 2px solid var(--accent-vermilion);
			font-style: italic;
		}

		/* CHAPTER 3: BAR CHART & CHRONICLE */
		.chronicle-barchart-section {
			border-bottom: 1px solid var(--grid-line);
		}
		.chart-status-bar {
			padding: 16px 24px;
			border-bottom: 1px solid var(--grid-line);
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			flex-wrap: wrap;
			background: #ffffff;
		}
		.chart-status-item {
			display: flex;
			align-items: baseline;
			gap: 8px;
			font-family: var(--font-mono);
		}
		.cs-label {
			font-size: 0.75rem;
			color: var(--text-dim);
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.cs-val {
			font-size: 1.3rem;
			font-weight: 900;
			color: var(--text-black);
		}
		.cs-unit {
			font-size: 0.8rem;
			color: var(--text-dim);
		}
		.cs-legend-pill {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-size: 0.8rem;
			padding: 4px 12px;
			border: 1px solid var(--grid-line);
			background: var(--grid-bg);
			font-family: var(--font-mono);
		}
		.pill-article .legend-box {
			color: #111827;
			font-size: 0.75rem;
		}
		.pill-mess .legend-box {
			color: var(--accent-pink-main);
			font-size: 0.85rem;
		}
		.cs-peak {
			font-size: 0.8rem;
		}
		.cs-peak-val {
			font-weight: 700;
			color: var(--accent-vermilion);
		}

		/* Graphic Bar Stage */
		.barchart-container {
			padding: 40px 24px 20px 24px;
			border-bottom: 1px solid var(--grid-line);
			background: #ffffff;
			overflow-x: auto;
		}
		.barchart-stage {
			position: relative;
			height: 380px;
			min-width: 780px;
			display: flex;
			flex-direction: column;
		}
		.barchart-gridlines {
			position: absolute;
			inset: 0 0 100px 0;
			pointer-events: none;
			z-index: 1;
		}
		.gridline-row {
			position: absolute;
			left: 0;
			right: 0;
			display: flex;
			align-items: center;
			gap: 12px;
			transform: translateY(50%);
		}
		.gridline-label {
			font-family: var(--font-mono);
			font-size: 0.7rem;
			color: var(--text-muted);
			width: 40px;
			text-align: right;
			flex-shrink: 0;
		}
		.gridline-dash {
			flex: 1;
			height: 1px;
			border-bottom: 1px dashed var(--grid-line-soft);
		}
		.gridline-solid {
			flex: 1;
			height: 1px;
			background: var(--grid-line);
		}

		.barchart-columns {
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			height: 100%;
			position: relative;
			z-index: 2;
			gap: 10px;
			padding-left: 52px;
		}
		.bar-col-slot {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-end;
			height: 100%;
			cursor: pointer;
			transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.bar-col-slot:hover,
		.bar-col-slot.hover-sync {
			transform: translateY(-6px);
		}
		.bar-col-slot.mood-highlight {
			background: rgba(236, 72, 153, 0.05);
			border-radius: 4px;
		}

		.bar-track {
			height: 270px;
			display: flex;
			align-items: flex-end;
			justify-content: center;
			width: 100%;
		}
		.bar-pillar {
			width: 38px;
			display: flex;
			flex-direction: column;
			border: 1.5px solid var(--text-black);
			border-radius: 4px 4px 0 0;
			overflow: hidden;
			position: relative;
			box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
			transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.bar-col-slot:hover .bar-pillar,
		.bar-col-slot.hover-sync .bar-pillar {
			box-shadow: 4px 6px 0 rgba(0, 0, 0, 0.2);
			border-color: var(--accent-vermilion);
		}
		.bar-col-slot.col-peak .bar-pillar {
			border-color: #111827;
		}

		.bar-total-num {
			position: absolute;
			top: -24px;
			left: 50%;
			transform: translateX(-50%);
			font-family: var(--font-mono);
			font-size: 0.8rem;
			font-weight: 800;
			color: var(--text-black);
			white-space: nowrap;
			display: flex;
			align-items: center;
			gap: 2px;
		}
		.peak-star {
			color: var(--accent-vermilion);
			font-size: 0.7rem;
		}

		.bar-seg {
			width: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-mono);
			font-size: 0.68rem;
			font-weight: 700;
			transition: filter 0.2s;
		}
		.seg-mess {
			background: linear-gradient(180deg, #f472b6 0%, #ec4899 100%);
			color: #ffffff;
			border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		}
		.seg-article {
			background: #111827;
			color: #ffffff;
		}
		.bar-col-slot:hover .seg-mess,
		.bar-col-slot.hover-sync .seg-mess {
			filter: brightness(1.08);
		}

		.bar-col-meta {
			height: 90px;
			text-align: center;
			margin-top: 10px;
			border-top: 1px solid var(--grid-line);
			padding-top: 8px;
			width: 100%;
		}
		.bar-month-title {
			font-family: var(--font-mono);
			font-size: 0.95rem;
			font-weight: 800;
			color: var(--text-black);
			margin-bottom: 4px;
		}
		.bar-quantities {
			display: flex;
			flex-direction: column;
			gap: 2px;
			font-family: var(--font-mono);
			font-size: 0.7rem;
			font-weight: 600;
			line-height: 1.35;
		}
		.qty-art {
			color: #374151;
		}
		.qty-mess {
			color: #db2777;
		}

		/* 12-Month Structural Summary Grid */
		.month-cards-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1px;
			background: var(--grid-line);
		}
		.month-card {
			background: #ffffff;
			padding: 16px 20px;
			display: flex;
			flex-direction: column;
			gap: 10px;
			transition: all 0.2s ease;
			cursor: default;
		}
		.month-card:hover,
		.month-card.hover-sync {
			background: #fff8f9;
		}
		.month-card.mood-highlight {
			background: #fdf2f8;
			outline: 2px solid var(--accent-pink-main);
			outline-offset: -2px;
		}
		.month-card.card-peak {
			background: #fafafa;
		}

		.mc-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			border-bottom: 1px solid var(--grid-line-soft);
			padding-bottom: 8px;
		}
		.mc-month-badge {
			font-family: var(--font-mono);
			font-size: 0.95rem;
			font-weight: 800;
			color: var(--text-black);
		}
		.mc-total-tag {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			font-weight: 700;
			background: var(--grid-bg);
			border: 1px solid var(--grid-line);
			padding: 2px 8px;
			color: var(--text-black);
		}
		.card-peak .mc-total-tag {
			background: #111827;
			color: #ffffff;
			border-color: #111827;
		}

		.mc-counts-row {
			display: flex;
			align-items: center;
			gap: 10px;
			font-family: var(--font-mono);
			font-size: 0.8rem;
		}
		.mc-stat-item {
			display: flex;
			align-items: center;
			gap: 6px;
		}
		.stat-dot {
			font-size: 0.7rem;
		}
		.dot-art {
			color: #111827;
		}
		.dot-mess {
			color: var(--accent-pink-main);
		}
		.stat-name {
			color: var(--text-dim);
		}
		.stat-num {
			font-weight: 800;
			color: var(--text-black);
		}
		.mc-stat-mess .stat-num {
			color: #db2777;
		}
		.mc-stat-sep {
			color: var(--grid-line);
		}

		.mc-mood-row {
			display: flex;
			flex-wrap: wrap;
			gap: 4px;
			margin-top: 4px;
		}
		.mc-mood-chip {
			font-family: var(--font-mono);
			font-size: 0.68rem;
			padding: 1px 6px;
			border: 1px solid var(--mc-mood);
			color: var(--mc-mood);
			background: rgba(0, 0, 0, 0.02);
			border-radius: 2px;
		}

		/* CHAPTER 4: THE GENTLE PINK CHAMBER */
		.pink-quote-chamber {
			border-bottom: 1px solid var(--grid-line);
			background: var(--accent-pink-soft);
			padding: 70px 40px;
			position: relative;
		}
		.chamber-frame {
			max-width: 900px;
			margin: 0 auto;
			border: 1.5px solid #f472b6;
			background: #ffffff;
			padding: 56px 48px;
			position: relative;
			box-shadow: 12px 12px 0 #fbcfe8;
		}
		.chamber-corner {
			position: absolute;
			width: 24px;
			height: 24px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 0.9rem;
			color: var(--accent-pink-main);
			background: #ffffff;
		}
		.corner-tl { top: -12px; left: -12px; }
		.corner-tr { top: -12px; right: -12px; }
		.corner-bl { bottom: -12px; left: -12px; }
		.corner-br { bottom: -12px; right: -12px; }

		.chamber-tag {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-family: var(--font-mono);
			font-size: 0.75rem;
			font-weight: 800;
			color: var(--accent-pink-main);
			margin-bottom: 24px;
			letter-spacing: 0.08em;
		}
		.tag-sep { opacity: 0.5; }

		.chamber-quote-text {
			margin: 0 0 28px;
			font-family: var(--font-serif);
			font-size: clamp(1.4rem, 3.2vw, 2.3rem);
			font-weight: 800;
			line-height: 1.6;
			color: #831843;
			letter-spacing: 0.02em;
		}
		.chamber-passage {
			font-family: var(--font-serif);
			font-size: 1rem;
			line-height: 1.9;
			color: #4b5563;
			margin-bottom: 36px;
			text-align: justify;
		}
		.chamber-footer-bar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-top: 1px solid #fce7f3;
			padding-top: 20px;
			font-family: var(--font-mono);
			font-size: 0.8rem;
		}
		.cite-meta {
			display: flex;
			gap: 14px;
			color: #9d174d;
			font-weight: 600;
		}
		.btn-source-jump {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: var(--text-black);
			text-decoration: none;
			font-weight: 700;
			padding: 6px 14px;
			border: 1px solid var(--grid-line);
			transition: all 0.2s;
		}
		.btn-source-jump:hover {
			background: var(--text-black);
			color: #ffffff;
		}

		/* CHAPTER 5: CONSTELLATION LEXICON */
		.constellation-matrix {
			border-bottom: 1px solid var(--grid-line);
		}
		.lexicon-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
		}
		.lexicon-item {
			padding: 16px 20px;
			border-right: 1px solid var(--grid-line-soft);
			border-bottom: 1px solid var(--grid-line-soft);
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			font-family: var(--font-mono);
			transition: background 0.15s;
		}
		.lexicon-item:hover {
			background: var(--grid-bg);
		}
		.lexicon-item.item-pink {
			background: #fff5f7;
		}
		.lexicon-item.item-pink:hover {
			background: #ffe4e9;
		}
		.lex-rank {
			font-size: 0.7rem;
			color: var(--text-muted);
		}
		.lex-word {
			font-weight: 700;
			font-size: 0.95rem;
			font-family: var(--font-serif);
		}
		.item-pink .lex-word {
			color: #be185d;
		}
		.lex-count {
			font-size: 0.75rem;
			color: var(--text-dim);
		}

		/* FOOTER */
		.grid-footer {
			display: grid;
			grid-template-columns: 2fr 1.5fr 2fr;
		}
		.footer-cell {
			padding: 32px 24px;
			border-right: 1px solid var(--grid-line);
			display: flex;
			flex-direction: column;
			justify-content: center;
		}
		.footer-cell:last-child {
			border-right: none;
		}
		.colophon-title {
			font-weight: 800;
			font-size: 1rem;
			margin-bottom: 6px;
		}
		.colophon-desc {
			font-size: 0.82rem;
			color: var(--text-dim);
			line-height: 1.6;
		}
		.action-center {
			align-items: center;
		}
		.btn-main-return {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			background: var(--text-black);
			color: #ffffff;
			text-decoration: none;
			padding: 12px 24px;
			font-weight: 800;
			font-size: 0.9rem;
			border: 1px solid var(--text-black);
			transition: all 0.2s;
			box-shadow: 4px 4px 0 var(--accent-vermilion);
		}
		.btn-main-return:hover {
			background: var(--accent-vermilion);
			border-color: var(--accent-vermilion);
			transform: translate(-2px, -2px);
			box-shadow: 6px 6px 0 var(--text-black);
		}
		.meta-right {
			align-items: flex-end;
			font-family: var(--font-mono);
			font-size: 0.75rem;
			color: var(--text-muted);
			gap: 4px;
		}

		/* RESPONSIVENESS */
		@media (max-width: 1024px) {
			.grid-header {
				grid-template-columns: 1fr 1fr;
			}
			.coord-cell, .status-cell {
				display: none;
			}
			.hero-statement-grid {
				grid-template-columns: 1fr;
			}
			.statement-left {
				border-right: none;
				border-bottom: 1px solid var(--grid-line);
			}
			.matrix-dual-grid {
				grid-template-columns: 1fr;
			}
			.cell-rational {
				border-right: none;
				border-bottom: 1px solid var(--grid-line);
			}
			.mood-cells-grid {
