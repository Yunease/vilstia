---
import memoryData from "../../../data/memory-2025.json";

const { monthlyStats, moodStats, top100Words, articles } = memoryData;
const byMood = moodStats.byMood as Record<string, number>;

// Extract monthly moods breakdown
const monthlyMoods: Record<string, Record<string, number>> = {};
articles.forEach((item) => {
	if (item.mood) {
		const m = item.isoDate.slice(0, 7);
		if (!monthlyMoods[m]) monthlyMoods[m] = {};
		monthlyMoods[m][item.mood] = (monthlyMoods[m][item.mood] || 0) + 1;
	}
});

// Mood configuration: precise, vibrant yet restrained in the Swiss layout
const MOOD_META: Record<string, { label: string; color: string; bg: string; sign: string }> = {
	怨恨: { label: "怨恨", color: "#8B5CF6", bg: "rgba(139, 92, 246, 0.08)", sign: "▲ 渡鸦之羽" },
	平和: { label: "平和", color: "#EC4899", bg: "rgba(236, 72, 153, 0.1)", sign: "● 祝福" },
	开心: { label: "开心", color: "#10B981", bg: "rgba(16, 185, 129, 0.08)", sign: "✦ 舞蹈和跳跃" },
	消沉: { label: "消沉", color: "#64748B", bg: "rgba(100, 116, 139, 0.08)", sign: "■ 水沉" },
	振奋: { label: "振奋", color: "#F97316", bg: "rgba(249, 115, 22, 0.08)", sign: "★ 车下草" },
	焦躁: { label: "焦躁", color: "#EF4444", bg: "rgba(239, 68, 68, 0.08)", sign: "◆ 热空气" },
};

const CORE_QUOTE = {
	highlight: "我是由过去的一切构成的，但过去的一切绝非必然的，只是从如今的眼光来看，它们都恰好发生过了而已。",
	extended:
		"提起笔写下那些斑驳的童话，从回忆里抽取夕阳覆盖灰色的天空，那些被遮蔽的也曾绚烂过。欢动的车厢摇摆出浅粉色的絮语，在笔下重构出新的枝桠——虚构是人的表象，我总是忍不住多留下点属于我的印痕，在许久之后也能辨认出来。工厂的烟囱们，你们也留下吧，时间已经足够灰了。",
	date: "2025-12-11 17:15:01",
	mood: "平和",
	moodLevel: 1,
	url: "/posts/message/old/mess%20-%20%E5%89%AF%E6%9C%AC%20(8)/",
};
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>2025 年度记录 · 理性格网与粉色絮语 | 樟庭徊路</title>
	<meta name="description" content="2025 年度记录：理性格网与粉色絮语。170 个发生过的文字切片与心境回声。" />
	<link rel="icon" type="image/svg+xml" href="/favicon/favicon.ico" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;600;700;900&display=swap" rel="stylesheet" />
</head>
<body class="memory-2025-root" data-no-swup>
	<!-- Kinetic Ticker Tape Top Bar -->
	<aside class="ticker-wrap" aria-hidden="true">
		<div class="ticker-track">
			<span class="ticker-item">樟庭徊路 · 2025 年度记述</span>
			<span class="ticker-sep">✿</span>
			<span class="ticker-item">“谁懂这种抽象感，早上写代码是理科生，晚上写同人文是文科生”</span>
			<span class="ticker-sep">✦</span>
			<span class="ticker-item">“每当我质疑生命的韧性时，命运就会回馈以温暖的触摸，我想它大概也是温柔的”</span>
			<span class="ticker-sep">꒰｡ › ·̮ ‹ ｡꒱</span>
			<span class="ticker-item">“没有任何一个离家在外的陕西人可以拒绝一碗纯手掰鲜嫩多汁的羊肉泡馍”</span>
			<span class="ticker-sep">✿</span>
			<span class="ticker-item">“人生如果是宝可梦就好了，这样我就可以发起上司拒绝不了的战斗，用替守毒恶心死别人”</span>
			<span class="ticker-sep">✦</span>
			<span class="ticker-item">“真正年轻的是可以泰然自若跟老板再买一根冰棍，无视他人眼神的心态”</span>
			<span class="ticker-sep">꒰｡ › ·̮ ‹ ｡꒱</span>
			<span class="ticker-item">“接近群山的人群山告诉他人类渺小，接近云雾的人云雾告诉他自然宽容 · 向泰山出发！”</span>
			<span class="ticker-sep">✿</span>
			<span class="ticker-item">“写 c 我用 goto，写 css 我用 important，傻逼的不是代码，是我自己”</span>
			<span class="ticker-sep">✦</span>
			<span class="ticker-item">“连裤袜就是最棒的！买到了双层加绒黑丝，穿起来超级无敌舒服摸起来也软软滑滑”</span>
			<span class="ticker-sep">✿</span>
		</div>
	</aside>

	<!-- Main Structural Grid Container -->
	<div class="swiss-layout">
		<!-- HEADER: Architectural Identity -->
		<header class="grid-header">
			<div class="header-cell brand-cell">
				<a href="/memory/" data-no-swup class="brand-link">
					<span class="brand-flag">2025 卷</span>
					<span class="brand-name">樟庭徊路 · 年度印痕</span>
				</a>
			</div>
			<div class="header-cell coord-cell">
				<span class="coord-label">岁月斜角</span>
				<span class="coord-val">2025.01.02 — 2025.12.30</span>
			</div>
			<div class="header-cell status-cell">
				<span class="live-dot"></span>
				<span class="status-text">170 篇 ✿</span>
			</div>
			<div class="header-cell back-cell">
				<a href="/memory/" data-no-swup class="btn-back">
					<span>返回记忆总览</span>
				</a>
			</div>
		</header>

		<!-- HERO MONUMENT: Monumental Typography -->
		<section class="monument-hero">
			<div class="monument-top-bar">
				<div class="top-tag">编年落绢 · 2025</div>
				<div class="top-theme">理性推演与日常絮语之间 ✿</div>
				<div class="top-count">第 001 — 170 篇</div>
			</div>

			<div class="monument-title-box">
				<div class="big-year-wrap">
					<span class="year-digit">2</span>
					<span class="year-digit">0</span>
					<span class="year-digit">2</span>
					<span class="year-digit special-digit">5<sup class="cute-star">✿</sup></span>
				</div>
			</div>

			<div class="hero-statement-grid">
				<div class="statement-col statement-left">
					<p class="statement-lead">
						“以我过去的目光来看，我无疑是无比憧憬如今的自己的，好吧，除了没有长高之外。如果明年还能以这样的形态看待现在的自己，大概也算没有虚度人生了吧。”
					</p>
					<span class="statement-sub">成败得失，命运使然也。人只能干预过程，却不能左右结果。现在最该考虑的，是今晚回去吃什么，以及让日子过得更轻松一些。</span>
				</div>
				<div class="statement-col statement-metrics">
					<div class="metric-block">
						<span class="m-num counter" data-target="170">0</span>
						<span class="m-label">总文章数</span>
					</div>
					<div class="metric-block">
						<span class="m-num counter" data-target="72">0</span>
						<span class="m-label">博客文章</span>
					</div>
					<div class="metric-block">
						<span class="m-num counter" data-target="98">0</span>
						<span class="m-label">短吐槽</span>
					</div>
				</div>
			</div>
		</section>

		<!-- CHAPTER 1: DUALITY MATRIX (Grey Rationality vs. Tender Pink Whimsy) -->
		<section class="duality-matrix">
			<div class="matrix-header-bar">
				<span class="chapter-badge">第一章 · 苓屏湛波水消从</span>
				<h2 class="matrix-heading">白昼的格线与夜里的温存</h2>
				<span class="matrix-desc">镰收秋风，我不会宽恕你的。</span>
			</div>

			<div class="matrix-dual-grid">
				<!-- Left Cell: The Grey/Black Intellectual Anchor -->
				<div class="dual-cell cell-rational">
					<div class="cell-tag-bar">
						<span class="side-code">01 / 白昼 · 螺旋塔</span>
						<span class="side-stat">135 次调试</span>
					</div>
					<h3 class="cell-title">刻度 · 算法、试卷与必须走过的路</h3>
					<p class="cell-text">
						卷积神经网络的对比实验、A*启发式搜索的理论求索、反复琢磨的数据库范式、以及期末考前深夜整理的教育心理学题目汇编。
					</p>
					<div class="cell-keywords">
						<span class="kw-tag">写c用goto</span>
						<span class="kw-tag">css用!important</span>
						<span class="kw-tag">哈基算法</span>
						<span class="kw-tag">A*搜索</span>
						<span class="kw-tag">数据库范式</span>
						<span class="kw-tag">离散数学坠机</span>
					</div>
					<div class="cell-quote">
						“其实我总有一种感觉。沉迷技术的人有意在逃避政治，但我又不够沉迷，我一定是因为这样才痛苦的……页面出错的时候，每一个 ul 都不是无辜的。”
					</div>
				</div>

				<!-- Right Cell: The Gentle Pink Tender Sanctuary -->
				<div class="dual-cell cell-whimsical">
					<div class="cell-tag-bar">
						<span class="side-code pink-code">02 / 霞色 · 假面与呼吸 ✿</span>
						<span class="side-stat pink-stat">晶振与日常絮语</span>
					</div>
					<h3 class="cell-title pink-title">温柔的私语 · 故事、日常与想对自己说的话 ꒰｡ › ·̮ ‹ ｡꒱</h3>
					<p class="cell-text">
						在代码与书本之外，笔下重构出了新的枝桠。小说《晶振》与《拉利玛》的纯粹文学热忱；全世界空洞骑士水平下降100万倍的逗趣连载；冬夜里为一条保暖裤袜认真写下的测评；还有在游戏里和好朋友们热闹度过的生日。
					</p>
					<div class="cell-keywords">
						<span class="kw-tag pink-kw">波克基斯最萌 ✿</span>
						<span class="kw-tag pink-kw">手掰羊肉泡馍</span>
						<span class="kw-tag pink-kw">双层加绒黑丝</span>
						<span class="kw-tag pink-kw">空洞骑士 ✦</span>
						<span class="kw-tag pink-kw">向泰山出发</span>
						<span class="kw-tag pink-kw">天恩空气斩</span>
					</div>
					<div class="cell-quote pink-quote">
						“我又幻想了。幻想我是能召唤出波克基斯的训练家，每天去罗德岛打卡给阿米娅臭脸色，跟大哥晨练偷学炒螺，下午去钓鱼约会……波克基斯就是最完美的宝可梦，有什么意见跟我的天恩空气斩说去吧！”
					</div>
				</div>
			</div>
		</section>

		<!-- CHAPTER 2: MOOD SPECTRUM MATRIX -->
		<section class="mood-matrix">
			<div class="matrix-header-bar">
				<span class="chapter-badge">第二章 · 涨涨落落</span>
				<h2 class="matrix-heading">心灵碎片：98 段随手写下的短思</h2>
				<span class="matrix-desc">其实我认为不靠抱枕就能睡着的人，也许有一种超能力</span>
			</div>

			<div class="mood-cells-grid">
				{Object.entries(MOOD_META).map(([moodKey, meta]) => {
					const count = byMood[moodKey] || 0;
					const percent = ((count / 98) * 100).toFixed(1);
					return (
						<button
							class="mood-grid-cell"
							data-mood={moodKey}
							style={`--m-color: ${meta.color}; --m-bg: ${meta.bg};`}
						>
							<div class="mood-cell-top">
								<span class="mood-sign">{meta.sign}</span>
								<span class="mood-name">{meta.label}</span>
								<span class="mood-count">{count}</span>
							</div>
							<div class="mood-bar-track">
								<div class="mood-bar-fill" style={`width: ${percent}%;`}></div>
							</div>
							<div class="mood-cell-bot">
								<span class="mood-pct">{percent}%</span>
								<span class="mood-hint">点击查看月度流向</span>
							</div>
						</button>
					);
				})}
			</div>

			<div class="mood-focus-banner" id="mood-focus-banner" style="display: none;">
				<div class="mf-left">
					<span class="mf-dot">✿</span>
					<span class="mf-title">心境透视 · <strong id="mf-mood-name"></strong>: </span>
					<span id="mf-mood-detail"></span>
				</div>
				<button id="btn-clear-mf" class="btn-clear-filter">清除聚焦</button>
			</div>

			<!-- Dynamic Voice of the Mood -->
			<div class="mood-quote-display" id="mood-quote-box">
				<div class="mq-meta">
					<span class="mq-tag" id="mq-tag">平和 Lv1</span>
					<span class="mq-date" id="mq-date">2025-11-12 09:57</span>
				</div>
				<p class="mq-text" id="mq-text">
					“每当我质疑生命的韧性时，命运就会回馈以温暖的触摸，完全不同往日严厉的模样，陌生又毫不违和。我想它大概也是温柔的，像我一样。”
				</p>
			</div>
		</section>

		<!-- CHAPTER 3: MONTHLY CHRONICLE BAR CHART -->
		<section class="chronicle-barchart-section" id="chronicle">
			<div class="matrix-header-bar">
				<span class="chapter-badge">第三章 · 编年</span>
				<h2 class="matrix-heading">湿润河床</h2>
				<span class="matrix-desc">时间在 12 个月度里起伏流淌</span>
			</div>

			<!-- Status & Legend Bar -->
			<div class="chart-status-bar">
				<div class="chart-status-item">
					<span class="cs-label">总篇数</span>
					<span class="cs-val counter" data-target="170">0</span>
					<span class="cs-unit">篇</span>
				</div>
				<div class="chart-status-item">
					<span class="cs-legend-pill pill-article">
						<span class="legend-box box-article">■</span>
						<span>文章: <strong>72</strong> 篇 (42.4%)</span>
					</span>
				</div>
				<div class="chart-status-item">
					<span class="cs-legend-pill pill-mess">
						<span class="legend-box box-mess">✿</span>
						<span>短吐槽: <strong>98</strong> 篇 (57.6%)</span>
					</span>
				</div>
				<div class="chart-status-item cs-peak">
					<span class="cs-label">创作双峰月</span>
					<span class="cs-peak-val">04月 (28篇) · 11月 (26篇)</span>
				</div>
			</div>

			<!-- The Graphic Swiss Bar Chart Stage -->
			<div class="barchart-container">
				<div class="barchart-stage">
					<!-- Y-Axis Reference Guidelines -->
					<div class="barchart-gridlines" aria-hidden="true">
						<div class="gridline-row" style="bottom: 100%;">
							<span class="gridline-label">30 篇</span>
							<div class="gridline-dash"></div>
						</div>
						<div class="gridline-row" style="bottom: 66.66%;">
							<span class="gridline-label">20 篇</span>
							<div class="gridline-dash"></div>
						</div>
						<div class="gridline-row" style="bottom: 33.33%;">
							<span class="gridline-label">10 篇</span>
							<div class="gridline-dash"></div>
						</div>
						<div class="gridline-row" style="bottom: 0%;">
							<span class="gridline-label">0</span>
							<div class="gridline-solid"></div>
						</div>
					</div>

					<!-- The 12 Columns -->
					<div class="barchart-columns">
						{Object.entries(monthlyStats).map(([mKey, mStat]) => {
							const mNum = mKey.replace("2025-", "");
							const totalHeightPct = ((mStat.total / 30) * 100).toFixed(1);
							const artHeightPct = ((mStat.nonMess / mStat.total) * 100).toFixed(1);
							const messHeightPct = ((mStat.mess / mStat.total) * 100).toFixed(1);
							const isPeak = mStat.total >= 25;

							return (
								<div
									class={`bar-col-slot ${isPeak ? "col-peak" : ""}`}
									data-month={mKey}
									data-total={mStat.total}
									data-article={mStat.nonMess}
									data-mess={mStat.mess}
								>
									<!-- The Bar Track & Stacked Segments -->
									<div class="bar-track">
										<div
											class="bar-pillar"
											style={`height: ${totalHeightPct}%;`}
										>
											<div class="bar-total-num">
												{mStat.total}
												{isPeak && <span class="peak-star">✦</span>}
											</div>

											<!-- Upper segment: 短吐槽 (Pink) -->
											<div
												class="bar-seg seg-mess"
												style={`height: ${messHeightPct}%;`}
												title={`${mNum}月 短吐槽: ${mStat.mess} 篇`}
											>
												{mStat.mess >= 6 && (
													<span class="seg-val">{mStat.mess}</span>
												)}
											</div>

											<!-- Lower segment: 文章 (Charcoal) -->
											<div
												class="bar-seg seg-article"
												style={`height: ${artHeightPct}%;`}
												title={`${mNum}月 文章: ${mStat.nonMess} 篇`}
											>
												{mStat.nonMess >= 4 && (
													<span class="seg-val">{mStat.nonMess}</span>
												)}
											</div>
										</div>
									</div>

									<!-- Column Bottom Label & Breakdown Text -->
									<div class="bar-col-meta">
										<div class="bar-month-title">{mNum}月</div>
										<div class="bar-quantities">
											<div class="qty-line qty-art">文章 {mStat.nonMess}篇</div>
											<div class="qty-line qty-mess">短吐槽 {mStat.mess}篇</div>
										</div>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</div>

			<!-- 12-Month Structural Summary Grid (Responsive Card Table) -->
			<div class="month-cards-grid">
				{Object.entries(monthlyStats).map(([mKey, mStat]) => {
					const mNum = mKey.replace("2025-", "");
					const isPeak = mStat.total >= 25;
					const mMoods = monthlyMoods[mKey] || {};

					return (
						<div class={`month-card ${isPeak ? "card-peak" : ""}`} data-month={mKey}>
							<div class="mc-head">
								<span class="mc-month-badge">{mNum} 月份</span>
								<span class="mc-total-tag">共 {mStat.total} 篇</span>
							</div>

							<div class="mc-counts-row">
								<div class="mc-stat-item mc-stat-art">
									<span class="stat-dot dot-art">■</span>
									<span class="stat-name">文章</span>
									<span class="stat-num">{mStat.nonMess} 篇</span>
								</div>
								<div class="mc-stat-sep">/</div>
								<div class="mc-stat-item mc-stat-mess">
									<span class="stat-dot dot-mess">✿</span>
									<span class="stat-name">短吐槽</span>
									<span class="stat-num">{mStat.mess} 篇</span>
								</div>
							</div>

							<!-- Subtle Mood Spectrum of the Month -->
							{Object.keys(mMoods).length > 0 && (
								<div class="mc-mood-row">
									{Object.entries(mMoods).map(([moodName, moodCount]) => {
										const meta = MOOD_META[moodName];
										return (
											<span
												class="mc-mood-chip"
												data-mood-chip={moodName}
												style={`--mc-mood: ${meta?.color || "#111827"};`}
												title={`${moodName}: ${moodCount} 篇`}
											>
												{moodName} {moodCount}
											</span>
										);
									})}
								</div>
							)}
						</div>
					);
				})}
			</div>
		</section>

		<!-- CHAPTER 4: THE GENTLE PINK CHAMBER (The Anchor Quote) -->
		<section class="pink-quote-chamber">
			<div class="chamber-frame">
				<div class="chamber-corner corner-tl">✿</div>
				<div class="chamber-corner corner-tr">✦</div>
				<div class="chamber-corner corner-bl">✦</div>
				<div class="chamber-corner corner-br">✿</div>

				<div class="chamber-tag">
					<span>第四章 · 絮语 ✿</span>
					<span class="tag-sep">·</span>
