		</section>

		<!-- CHAPTER 5: CONCEPT CONSTELLATION -->
		<section class="constellation-matrix">
			<div class="matrix-header-bar">
				<span class="chapter-badge">第五章 · 词谱</span>
				<h2 class="matrix-heading">使用过的词语们</h2>
				<span class="matrix-desc">我没办法像小孩一样说出轻佻的话来，完全意气用事，说出感人肺腑的荒诞言论。</span>
			</div>

			<div class="lexicon-grid">
				{top100Words.slice(0, 32).map((w, i) => {
					const isPink = ["晶振", "连裤袜", "迷拟丘", "罗德岛", "硝烟", "灵魂", "骑士", "山茶花", "生活"].includes(w.word);
					return (
						<div class={`lexicon-item ${isPink ? "item-pink" : ""}`}>
							<span class="lex-rank">{(i + 1).toString().padStart(2, "0")}</span>
							<span class="lex-word">{w.word}</span>
							<span class="lex-count">{w.count}</span>
						</div>
					);
				})}
			</div>
		</section>

		<!-- FOOTER COLOPHON: Return & Sealing -->
		<footer class="grid-footer">
			<div class="footer-cell left-info">
				<div class="colophon-title">2025</div>
				<div class="colophon-desc">
					时间不断向前走，过去被压缩。
				</div>
			</div>
			<div class="footer-cell action-center">
				<a href="/memory/" data-no-swup class="btn-main-return">
					<span>返回年度记录总览</span>
				</a>
			</div>
			<div class="footer-cell meta-right">
				<div class="foot-label">樟庭徊路 🌙 · 2025</div>
				<div class="foot-copy">琴泠的梦境、碎碎念与创作 · 年度记录封存</div>
			</div>
		</footer>
