	<!-- Interactive Logic -->
	<script is:inline>
		(function () {
			// 1. Playful Sparkle on Click (Creates a tiny ✿ or ✦ at cursor)
			const SPARKLE_ICONS = ["✿", "✦", "✧", "꒰·̮·꒱", "●"];
			const SPARKLE_COLORS = ["#FF4D00", "#EC4899", "#8B5CF6", "#10B981", "#111827"];

			function createSparkle(e) {
				const spark = document.createElement("div");
				spark.className = "click-sparkle";
				spark.textContent = SPARKLE_ICONS[Math.floor(Math.random() * SPARKLE_ICONS.length)];
				spark.style.color = SPARKLE_COLORS[Math.floor(Math.random() * SPARKLE_COLORS.length)];
				spark.style.left = e.clientX + "px";
				spark.style.top = e.clientY + "px";
				document.body.appendChild(spark);
				setTimeout(() => spark.remove(), 700);
			}
			window.addEventListener("click", createSparkle);

			// 2. Animated Number Counters
			const counters = document.querySelectorAll(".counter");
			const counterObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const el = entry.target;
							const target = parseInt(el.getAttribute("data-target") || "0", 10);
							let cur = 0;
							const step = Math.max(1, Math.floor(target / 30));
							const timer = setInterval(() => {
								cur += step;
								if (cur >= target) {
									el.textContent = String(target);
									clearInterval(timer);
								} else {
									el.textContent = String(cur);
								}
							}, 25);
							observer.unobserve(el);
						}
					});
				},
				{ threshold: 0.3 }
			);
			counters.forEach((c) => counterObserver.observe(c));

			// 3. Mood Focus & Month Chart Highlights Interaction
			const moodCells = document.querySelectorAll(".mood-grid-cell");
			const moodFocusBanner = document.getElementById("mood-focus-banner");
			const mfMoodName = document.getElementById("mf-mood-name");
			const mfMoodDetail = document.getElementById("mf-mood-detail");
			const btnClearMf = document.getElementById("btn-clear-mf");
			const mqTag = document.getElementById("mq-tag");
			const mqDate = document.getElementById("mq-date");
			const mqText = document.getElementById("mq-text");

			const barSlots = document.querySelectorAll(".bar-col-slot");
			const monthCards = document.querySelectorAll(".month-card");

			const MOOD_MONTH_DIST = {
				怨恨: "共 33 篇碎片 · 集中分布在：11月 (11篇) · 4月 (8篇) · 10月 (4篇) · 3月 (3篇)",
				平和: "共 20 篇碎片 · 集中分布在：11月 (8篇) · 4月 (4篇) · 5月 (2篇) · 10月 (2篇)",
				开心: "共 16 篇碎片 · 集中分布在：5月 (3篇) · 2月 (2篇) · 3月 (2篇) · 11月 (2篇) · 12月 (2篇)",
				消沉: "共 14 篇碎片 · 集中分布在：4月 (3篇) · 9月 (3篇) · 7月 (2篇) · 10月 (2篇)",
				振奋: "共 11 篇碎片 · 集中分布在：4月 (5篇) · 10月 (2篇) · 1月 (1篇) · 3月 (1篇) · 6月 (1篇)",
				焦躁: "共 4 篇碎片 · 集中分布在：10月 (2篇) · 4月 (1篇) · 12月 (1篇)",
			};

			const MOOD_VOICES = {
				平和: {
					tag: "平和 Lv1 · 岁末手记",
					date: "2025-11-12 09:57",
					text: "“每当我质疑生命的韧性时，命运就会回馈以温暖的触摸，完全不同往日严厉的模样，陌生又毫不违和。我想它大概也是温柔的，像我一样。”",
				},
				怨恨: {
					tag: "怨恨 Lv2 · 宝可梦现实主义",
					date: "2025-01-20 18:59",
					text: "“人生如果是宝可梦就好了，这样我就可以发起上司拒绝不了的战斗，用替守毒恶心死别人。”",
				},
				开心: {
					tag: "开心 Lv2 · 乡愁与美食",
					date: "2025-11-30 22:28",
					text: "“没有任何一个离家在外的陕西人可以拒绝一碗纯手掰鲜嫩多汁的羊肉泡馍，如果能拒绝那就说明你爱吃小炒！”",
				},
				消沉: {
					tag: "消沉 Lv3 · 课堂与困意",
					date: "2025-04-10 12:04",
					text: "“困晕了，数据库怎么这么好睡。怀疑老师是盾菇，一上课就撒蘑菇孢子害我睡着……这下是想不睡都不行了，睡！睡！睡！Zzzzzzzzz”",
				},
				振奋: {
					tag: "振奋 Lv4 · 理工与文艺左右脑",
					date: "2025-04-11 15:04",
					text: "“谁懂这种抽象感，早上写代码是理科生，晚上写同人文是文科生，有种左右脑互搏的美感。其实我是吃货，我要吃吃吃！”",
				},
				焦躁: {
					tag: "焦躁 Lv1 · 程序员自我修养",
					date: "2025-10-10 19:05",
					text: "“写 c 我用 goto，写 css 我用 important，命名我用拼音，注释我加一堆颜文字卖萌。我终于发现，傻逼的不是代码，是我自己。”",
				},
			};

			let activeMood = null;

			function setMoodFocus(mood) {
				if (activeMood === mood) {
					clearMoodFocus();
					return;
				}
				activeMood = mood;
				moodCells.forEach((c) => {
					if (c.getAttribute("data-mood") === mood) {
						c.classList.add("active");
					} else {
						c.classList.remove("active");
					}
				});

				if (moodFocusBanner && mfMoodName && mfMoodDetail) {
					mfMoodName.textContent = mood;
					mfMoodDetail.textContent = MOOD_MONTH_DIST[mood] || "";
					moodFocusBanner.style.display = "flex";
				}

				if (MOOD_VOICES[mood] && mqTag && mqDate && mqText) {
					mqTag.textContent = MOOD_VOICES[mood].tag;
					mqDate.textContent = MOOD_VOICES[mood].date;
					mqText.textContent = MOOD_VOICES[mood].text;
				}

				// Highlight months that have this mood
				monthCards.forEach((card) => {
					const mChip = card.querySelector(`[data-mood-chip="${mood}"]`);
					if (mChip) {
						card.classList.add("mood-highlight");
					} else {
						card.classList.remove("mood-highlight");
					}
				});

				barSlots.forEach((slot) => {
					const mKey = slot.getAttribute("data-month");
					const matchingCard = document.querySelector(`.month-card[data-month="${mKey}"] [data-mood-chip="${mood}"]`);
					if (matchingCard) {
						slot.classList.add("mood-highlight");
					} else {
						slot.classList.remove("mood-highlight");
					}
				});

				// Smooth scroll toward chronicle section
				const chronicle = document.getElementById("chronicle");
				if (chronicle) {
					chronicle.scrollIntoView({ behavior: "smooth" });
				}
			}

			function clearMoodFocus() {
				activeMood = null;
				moodCells.forEach((c) => c.classList.remove("active"));
				if (moodFocusBanner) moodFocusBanner.style.display = "none";
				monthCards.forEach((card) => card.classList.remove("mood-highlight"));
				barSlots.forEach((slot) => slot.classList.remove("mood-highlight"));

				if (MOOD_VOICES["平和"] && mqTag && mqDate && mqText) {
					mqTag.textContent = MOOD_VOICES["平和"].tag;
					mqDate.textContent = MOOD_VOICES["平和"].date;
					mqText.textContent = MOOD_VOICES["平和"].text;
				}
			}

			moodCells.forEach((cell) => {
				cell.addEventListener("click", () => {
					const mood = cell.getAttribute("data-mood");
					if (mood) setMoodFocus(mood);
				});
			});

			if (btnClearMf) {
				btnClearMf.addEventListener("click", clearMoodFocus);
			}

			// Hover sync between bar column and month card
			barSlots.forEach((slot) => {
				const mKey = slot.getAttribute("data-month");
				slot.addEventListener("mouseenter", () => {
					const targetCard = document.querySelector(`.month-card[data-month="${mKey}"]`);
					if (targetCard) targetCard.classList.add("hover-sync");
				});
				slot.addEventListener("mouseleave", () => {
					const targetCard = document.querySelector(`.month-card[data-month="${mKey}"]`);
					if (targetCard) targetCard.classList.remove("hover-sync");
				});
			});

			monthCards.forEach((card) => {
				const mKey = card.getAttribute("data-month");
				card.addEventListener("mouseenter", () => {
					const targetSlot = document.querySelector(`.bar-col-slot[data-month="${mKey}"]`);
					if (targetSlot) targetSlot.classList.add("hover-sync");
				});
				card.addEventListener("mouseleave", () => {
					const targetSlot = document.querySelector(`.bar-col-slot[data-month="${mKey}"]`);
					if (targetSlot) targetSlot.classList.remove("hover-sync");
				});
			});

			// Clean up listeners on unload
			window.addEventListener("beforeunload", () => {
				window.removeEventListener("click", createSparkle);
				counterObserver.disconnect();
			});
		})();
	</script>

	<!-- Scoped Styles -->
