				<blockquote class="chamber-quote-text">
					“{CORE_QUOTE.highlight}”
				</blockquote>

				<div class="chamber-passage">
					<p>{CORE_QUOTE.extended}</p>
				</div>

				<div class="chamber-footer-bar">
					<div class="cite-meta">
						<span class="cite-date">{CORE_QUOTE.date}</span>
						<span class="cite-mood">心境：{CORE_QUOTE.mood} Lv{CORE_QUOTE.moodLevel}</span>
